{
  "id": "./",
  "name": "Tunebox",
  "short_name": "Tunebox",
  "description": "Play the music on your computer or phone \u2014 works offline, with a smart DJ and equalizer.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#090a0f",
  "theme_color": "#090a0f",
  "categories": [
    "music",
    "entertainment"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screenshot-wide.jpg",
      "sizes": "1440x900",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Tunebox on a laptop"
    },
    {
      "src": "icons/screenshot-phone.jpg",
      "sizes": "390x844",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Tunebox on a phone"
    }
  ],
  "shortcuts": [
    {
      "name": "Start Tunebox DJ",
      "short_name": "DJ",
      "url": "./?dj=1",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Playlists",
      "url": "./?view=playlists",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Settings",
      "url": "./?view=settings",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/mp4": [
          ".m4a",
          ".m4b"
        ],
        "audio/aac": [
          ".aac"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/ogg": [
          ".ogg",
          ".oga",
          ".opus"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".mp3",
            ".m4a",
            ".flac",
            ".wav",
            ".ogg",
            ".opus",
            ".aac"
          ]
        }
      ]
    }
  }
}